DATABASE_URL=postgresql://localhost:5432/byline

OPENAI_API_KEY=
GEMINI_API_KEY=

# Clerk (required when BYLINE_AUTH != "disabled")
# The issuer URL is the base64-decoded host portion of your Clerk
# publishable key (or visible directly on the Clerk dashboard).
CLERK_ISSUER=
# Only set if you've configured a custom audience in the Clerk dashboard.
# CLERK_AUDIENCE=

# Local dev: set this to bypass Clerk and use a mock user.
# BYLINE_AUTH=disabled

# Optional: the Clerk org_id that gets operator privileges on the
# dashboard. An operator org's users can see NULL-org (seed/operator-
# owned) subjects in addition to their own org's subjects. Single-
# tenant for now — one configured operator org per deployment. Leave
# blank in customer-facing deployments.
# BYLINE_OPERATOR_ORG_ID=
