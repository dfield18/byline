# Copy to .env.local and fill in.

# Where the FastAPI backend is running.
# Local dev: http://localhost:8000 (uvicorn default).
# Production: the deployed FastAPI URL (Render/Fly/Railway).
BYLINE_API_URL=http://localhost:8000

# Bearer token for the API. While the API runs with BYLINE_AUTH=disabled
# (mock-user mode), any non-empty string works — use "dev-token". In
# production this will be the user's Clerk JWT (currently TODO).
BYLINE_API_TOKEN=dev-token

# Frontend auth bypass. Set to "disabled" to skip the Clerk session
# check in proxy.ts so curl / Lighthouse / agent inspection can hit
# /subjects/* directly instead of redirecting to the Clerk sign-in
# handshake. Hard-guarded by NODE_ENV in proxy.ts — has no effect in
# production builds. Pair with BYLINE_API_TOKEN above for a fully
# auth-bypassed local stack.
# BYLINE_AUTH=disabled
